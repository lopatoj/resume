{
	"name": "resume-tailor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "prisma generate && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "prisma migrate dev && prisma generate",
		"db:import": "node scripts/import.ts",
		"db:export": "node scripts/export.ts",
		"db:studio": "prisma studio",
		"claude:check": "node scripts/check-claude.ts",
		"jev:compare": "node --env-file-if-exists=.env scripts/compare-jev.ts",
		"jev:check-variants": "node --env-file-if-exists=.env scripts/check-variants.ts",
		"jev:eval": "node --env-file-if-exists=.env scripts/eval-checker.ts",
		"layout:calibrate": "node scripts/calibrate-layout.ts"
	},
	"devDependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.66.0",
		"@sveltejs/adapter-node": "latest",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prisma": "7.10.1",
		"shadcn-svelte": "^1.7.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*.js": "./src/lib/*.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@libsql/client": "^0.18.0",
		"@prisma/adapter-libsql": "7.10.1",
		"@prisma/client": "7.10.1",
		"@typesafe-ai/sdk": "0.7.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	}
}
