# Analysis provider: google, anthropic, or claude-cli. No cross-provider fallback.
# Unset: Google if its key exists, otherwise Anthropic if its key exists, else Claude Code.
LLM_PROVIDER=google
# Optional override; Google defaults to gemini-3.8-flash (currently has a free tier).
LLM_MODEL=
# Create a key at https://aistudio.google.com/apikey in a Free Tier project.
# Free-tier content may be used to improve Google products. Keep billing disabled to avoid charges.
GOOGLE_GENERATIVE_AI_API_KEY=
# Only used by the anthropic provider (separate API billing).
ANTHROPIC_API_KEY=
# Optional: Jev (TypeSafe) for relevance, posting tags, coverage and rewrite checks.
TYPESAFE_API_KEY=
